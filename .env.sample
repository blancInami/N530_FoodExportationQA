# 啟用 GatewayPlus（填入 token 即自動切換）
GW_Authorization="your_gateway_authorization_token_here"
EMBEDDING_GATEWAY_URL="https://your_gateway_url/v1/embeddings"
LLM_GATEWAY_URL="https://your_gateway_url/v1/chat/completions"

# === Embedding Server ===
EMBEDDING_HOST="127.0.0.1"
EMBEDDING_PORT=40003
EMBEDDING_MODEL="intfloat/multilingual-e5-large-instruct"
EMBEDDING_DIM=1024

# === LLM Server ===
LLM_HOST="127.0.0.1"
LLM_PORT=40040
LLM_MODEL="gemma-4-26B-A4B-it-mtp"

# === PostgreSQL ===
PG_HOST="127.0.0.1"
PG_PORT=5432
PG_USER="postgres"
PG_PASSWORD="your_postgres_password"
PG_DB="your_database_name"

# === Retrieval Parameters ===
SIMILARITY_THRESHOLD=0.75
TOP_K=30
TOP_N=5
# RETRIEVAL_MERGE_MODE: independent（預設）— 兩軌各自保留 top_n，不競爭名額
#                       compete       — 兩軌混排後共用 top_n 配額（舊行為）
RETRIEVAL_MERGE_MODE="compete"

# === Chunking Parameters ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# === Breakdown Parameters ===
# BREAKDOWN_ENGINE: 
#   - "v1"        : 舊版 Regex-Heavy 狀態機架構（對特定格式依賴重）
#   - "v2"        : LLM-First 全域骨架方案 A（純文字 Markdown 解析）
#   - "vlm"       : 視覺多模態並行解析（Word -> PDF -> 逐頁 JPG -> Vision 並行推論）
#   - "langgraph" : 擬人化循序閱讀狀態機（目錄大綱 + 逐頁研讀 + 跨頁碎片縫合 + 主動回讀審查）
BREAKDOWN_ENGINE="langgraph"

# === VLM / LangGraph 視覺模型設定 ===
# 若未設定 VLM_MODEL / VLM_URL，系統將自動沿用 LLM_MODEL 與 LLM_HOST:LLM_PORT
VLM_MODEL=""
VLM_URL=""
VLM_MAX_CONCURRENCY=4
VLM_DPI=150
# "images" (轉 JPG 影像) | "pdf_direct" (直傳 PDF)
VLM_INPUT_MODE="images"

# === VLM 轉檔圖片暫存與 MD5 快取設定 ===
# 設為 true 時，自動將轉檔之逐頁 JPEG 儲存至 temp_images/{file_md5}/，後續遇到相同檔案直接命中快取
VLM_SAVE_TEMP_IMAGES=false
VLM_TEMP_IMAGES_DIR="temp_images"

# === LibreOffice Daemon Worker Pool（Office 文件 → PDF 轉檔） ===
# LO_POOL_SIZE=0 停用資源池，每次轉檔冷啟動 soffice.exe；>0 則啟動時常駐 N 個 soffice daemon，以 UNO 轉檔
LO_POOL_SIZE=0
# worker_i 監聽 127.0.0.1:(LO_BASE_PORT+i+1)
LO_BASE_PORT=2000
# 單一 Worker 轉檔次數上限，達上限自動回收重啟
LO_MAX_CONVERSIONS=50
# true：啟動時等待所有 Worker 就緒；false：背景預熱，服務立即可用
LO_POOL_EAGER=false
# 等待閒置 Worker 秒數上限，逾時退回冷啟動
LO_ACQUIRE_TIMEOUT=60
